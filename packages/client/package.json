{
  "name": "@gonvex/client",
  "version": "0.5.2-staging.29",
  "type": "module",
  "sideEffects": [
    "./dist/sqlite-owner-worker.js",
    "./dist/sqlite-router-worker.js",
    "./dist/vendor/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./sqlite/broker": {
      "types": "./dist/sqlite-broker.d.ts",
      "default": "./dist/sqlite-broker.js"
    },
    "./sqlite/owner-worker": {
      "default": "./dist/sqlite-owner-worker.js"
    },
    "./sqlite/router-worker": {
      "default": "./dist/sqlite-router-worker.js"
    },
    "./sqlite-module": {
      "types": "./dist/vendor/sqlite3.d.mts",
      "default": "./dist/vendor/sqlite3.mjs"
    },
    "./sqlite/storage": {
      "types": "./dist/broker-sqlite-storage.d.ts",
      "default": "./dist/broker-sqlite-storage.js"
    },
    "./sqlite/owner": {
      "types": "./dist/sqlite-owner-actor.d.ts",
      "default": "./dist/sqlite-owner-actor.js"
    },
    "./sqlite/browser": {
      "types": "./dist/sqlite-browser-client.d.ts",
      "default": "./dist/sqlite-browser-client.js"
    },
    "./sqlite/program": {
      "types": "./dist/sqlite-client-program.d.ts",
      "default": "./dist/sqlite-client-program.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/sqlite-assets.mjs",
    "bench:sync-engine": "pnpm build && node bench/sync-engine/run.mjs",
    "bench:sync-engine:chromium": "pnpm build && node bench/sync-engine/chromium.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "pnpm build && vitest run && pnpm test:node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:sync-engine:check": "node --test bench/sync-engine/statistics.checks.mjs",
    "sqlite:rebuild": "node scripts/rebuild-sqlite.mjs",
    "test:node": "node --test scripts/sqlite-log-guards.test.mjs bench/sqlite-replica/fixture.test.mjs bench/sync-engine/statistics.checks.mjs test/sqlite-sahpool.checks.mjs"
  },
  "dependencies": {
    "@gonvex/local-runtime": "workspace:*",
    "@gonvex/module-sdk": "workspace:*",
    "@gonvex/protocol": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "dexie": "^4.4.4"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ]
}
