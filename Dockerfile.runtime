# TypeScript application modules execute in the bounded Rust/V8 module host.
# The Go process currently owns HTTP, Postgres transactions, the change feed,
# visibility routing, and the replica protocol; it never compiles application
# source or loads Go plugins.
FROM rust:1.94-bookworm AS module-host-build
WORKDIR /src/rust
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates ./crates
RUN cargo build --locked --release -p gonvex-module-host

# Build the CGO-enabled runtime against the same Debian release as the final
# image. The unqualified Go tag may advance to a newer glibc and produce a
# binary that cannot start in Bookworm.
FROM golang:1.26-bookworm@sha256:6ef6e30f0ea5c384f6d111cf856e024e3086bbdcb1779da3f3b3fbba0aea53d2 AS build
WORKDIR /src
ENV GOMAXPROCS=2 \
    GOFLAGS="-mod=mod -p=2"
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o /out/gonvex-runtime ./server/cmd/gonvex-runtime

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/gonvex/data /var/lib/gonvex/tmp
COPY --from=build /out/gonvex-runtime /usr/local/bin/gonvex-runtime
# TypeScript application functions execute in the bounded Rust/V8 module host.
# The Go runtime supervises this one process lazily when the first TypeScript
# artifact is synced; keeping the path explicit avoids PATH-dependent fallback.
COPY --from=module-host-build /src/rust/target/release/gonvex-module-host /usr/local/bin/gonvex-module-host
# Data-file artifacts (DuckDB databases for assistant-uploaded CSV/XLSX/XLS)
# live here; mount a volume to keep them across deploys. Artifacts re-ingest
# from object storage on miss, so an ephemeral dir also works (just slower on
# first access after a redeploy).
ENV GONVEX_ADDR=0.0.0.0:8080 \
    GONVEX_MODULE_HOST_ENABLED=true \
    GONVEX_MODULE_HOST_BINARY=/usr/local/bin/gonvex-module-host \
    GONVEX_DATA_DIR=/var/lib/gonvex/data \
    GONVEX_TELEMETRY_LOG=/var/lib/gonvex/telemetry.jsonl \
    TMPDIR=/var/lib/gonvex/tmp \
    GOMAXPROCS=2
WORKDIR /var/lib/gonvex
USER 0:0
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=30 \
  CMD bash -ec 'exec 3<>/dev/tcp/127.0.0.1/8080; printf "GET /healthz HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3; grep -q "200 OK" <&3'
CMD ["gonvex-runtime"]
