{
  "version": 2,
  "name": "whagons-1000-users",
  "users": 1000,
  "connectionsPerUser": 1.7,
  "pools": {
    "workspace": ["REPLACE_WITH_SEEDED_WORKSPACE_ID"],
    "task": ["REPLACE_WITH_SEEDED_TASK_ID"],
    "status": ["REPLACE_WITH_SEEDED_STATUS_ID"]
  },
  "subscriptionsPerConnection": [80, 81, 82, 89, 90, 92, 99],
  "subscriptions": [
    {"path": "bulk.tasksByWorkspace", "args": {"workspaceId": "$workspace"}, "count": 12},
    {"path": "bulk.taskPivotData", "args": {"workspaceId": "$workspace"}, "count": 10},
    {"path": "sync.recentWorkspaceTasks", "args": {"workspaceId": "$workspace"}, "count": 18},
    {"path": "settings.getByKey", "args": {}, "count": 4},
    {"path": "users.list", "args": {}},
    {"path": "sync.workspaces", "args": {}},
    {"path": "sync.statuses", "args": {}},
    {"path": "sync.categories", "args": {}},
    {"path": "sync.properties", "args": {}},
    {"path": "sync.teams", "args": {}},
    {"path": "sync.roles", "args": {}},
    {"path": "sync.tags", "args": {}},
    {"path": "sync.customFields", "args": {}},
    {"path": "sync.forms", "args": {}},
    {"path": "sync.taskForms", "args": {}},
    {"path": "approvals.listTaskApprovals", "args": {}, "count": 6},
    {"path": "taskResources.listTaskLogs", "args": {"taskId": "$task"}, "count": 8},
    {"path": "taskResources.listTaskNotes", "args": {"taskId": "$task"}, "count": 8},
    {"path": "taskResources.listTaskViewsByTaskId", "args": {"taskId": "$task"}, "count": 8},
    {"path": "advancedVoice.getAccess", "args": {}},
    {"path": "assistant.listThreads", "args": {}},
    {"path": "boards.list", "args": {}},
    {"path": "calls.listForUser", "args": {}},
    {"path": "chat.directMessageInboxSummary", "args": {}},
    {"path": "chat.listWorkspaceChat", "args": {"workspaceId": "$workspace"}},
    {"path": "developer.status", "args": {}},
    {"path": "gamification.badgesWithProgress", "args": {}},
    {"path": "gamification.myPointsSummary", "args": {}},
    {"path": "roles.effectivePermissions", "args": {}},
    {"path": "settings.listNotifications", "args": {}},
    {"path": "taskFindings.countsByTenant", "args": {}},
    {"path": "tenantBranding.getPublic", "args": {}},
    {"path": "userLiveLocations.list", "args": {}},
    {"path": "users.me", "args": {}}
  ],
  "mutations": [
    {
      "path": "tasks.create",
      "args": {"workspaceId": "$workspace", "statusId": "$status", "title": "Gonvex load task"},
      "ratePerUserPerMinute": 0.2,
      "activeUsers": 0.2
    },
    {
      "path": "tasks.update",
      "args": {"taskId": "$task", "statusId": "$status"},
      "ratePerUserPerMinute": 0.5,
      "activeUsers": 0.2
    },
    {
      "path": "workplans.generateDueWorkplans",
      "args": {},
      "ratePerMinute": 34.2
    },
    {
      "path": "techSupport.recordHeartbeat",
      "args": {},
      "ratePerMinute": 30
    }
  ]
}
